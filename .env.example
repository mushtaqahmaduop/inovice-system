# Copy to .env.local and fill in. NEVER commit any .env* file (CLAUDE.md §1).
# Two Supabase projects exist: STAGING and PRODUCTION (BUILD_PHASES 0.2/0.4).
# Local dev + preview deploys point at STAGING. Production values live only
# in Vercel's production environment.

# ── Supabase (staging values for local dev) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Supabase pooler, transaction mode)
DATABASE_URL=
# Session pooler (port 5432) — drizzle-kit migrations only
DATABASE_URL_MIGRATIONS=
# Service role key — rare, explicitly-justified admin operations ONLY
# (SCHEMA_DESIGN §5 service-role policy). Never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Destructive-script guard (audit F-3) ───────────────────────
# db/guard.mjs refuses to run tests, db:seed or db:reseed unless the target
# database is positively identified as disposable. Set this ONLY in the env
# file of a project you are willing to lose:
#   DB_ENV=staging      (or: development | test)
# Leave it UNSET on any machine whose .env.local points at production — unset
# means "treated as production", which is the safe default. The live project
# ref is refused outright regardless of this value, with no override.
DB_ENV=

# ── Sentry (task 7.2 / audit F-2 — SDK IS WIRED) ───────────────
# The SDK is installed and configured. It is INERT until a DSN is set: with
# these blank, init() is never called — no network, no overhead. Paste the DSN
# from the Sentry project to switch error reporting on; no code change needed.
# Both hold the SAME value. A DSN is write-only (it can submit events, never
# read them), so the NEXT_PUBLIC_ copy being in the browser bundle is expected.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only — set in Vercel, never in the repo. Without them the
# build skips source-map upload and still succeeds; with them, stack traces are
# readable instead of minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend deliberately absent — task 6.4 is blocked on Q-11–17 (BUILD_PHASES).
